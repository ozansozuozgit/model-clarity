# Set after deploying to Vercel (Project Settings → Domains, or your production URL)
NEXT_PUBLIC_SITE_URL=https://ai-cheatsheet.vercel.app

# Optional: used by npm run catalog:update to reconcile official model lists.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Optional catalog automation knobs.
# Set to 1 only when you want missing provider keys to fail catalog:update.
CATALOG_REQUIRE_CREDENTIALS=0
# Set to 1 to refresh lastVerified dates after official API or URL checks pass.
CATALOG_REFRESH_VERIFIED=0
# Set to 0 for offline local validation.
CATALOG_VALIDATE_URLS=1
